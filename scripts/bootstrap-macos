#!/usr/bin/env bash
# macOS half of the bootstrap task — the `platform` task in mise.macos.toml.
# Only runs on macOS, because mise only loads that config there.
# Idempotent: runs on every `mise bootstrap`.
set -euo pipefail
cd "$(dirname "$0")/.."

# ~/code is the stable path agents use; on the Mac it lives under Documents
# (iCloud-friendly) and ~/code is a symlink. Don't clobber a real ~/code dir.
mkdir -p "$HOME/Documents/code/references"
if [[ ! -e "$HOME/code" ]]; then
  ln -s "$HOME/Documents/code" "$HOME/code"
elif [[ -L "$HOME/code" ]]; then
  :
elif [[ -d "$HOME/code" ]]; then
  echo "bootstrap: warning: ~/code is a real directory; expected symlink to ~/Documents/code" >&2
  mkdir -p "$HOME/code/references"
fi

# DevboxDrop LaunchAgent. Not expressible in [bootstrap.macos.launchd.agents]:
# the agent is WatchPaths driven and mise's launchd schema has no WatchPaths or
# ThrottleInterval. The plist and script must also be real files outside
# ~/Documents — launchd-spawned processes can be denied TCC access to this repo,
# and login-time agent discovery is fragile when the plist is a symlink into
# Documents.
#
# Same TCC reason for sync-reference-repos: the declarative launchd agent runs
# the libexec copy, not the symlink-each path under ~/.local/bin.
mkdir -p "$HOME/.local/libexec" "$HOME/DevboxDrop" "$HOME/Library/LaunchAgents"
install -m 755 home/.local/bin/devbox-drop-sync.sh "$HOME/.local/libexec/devbox-drop-sync.sh"
install -m 755 home/.local/bin/sync-reference-repos "$HOME/.local/libexec/sync-reference-repos"

agent="$HOME/Library/LaunchAgents/dev.ani.devbox-drop.plist"
launchctl bootout "gui/$(id -u)/dev.ani.devbox-drop" 2>/dev/null || true
rm -f "$agent"
install -m 644 home/Library/LaunchAgents/dev.ani.devbox-drop.plist "$agent"
launchctl enable "gui/$(id -u)/dev.ani.devbox-drop" 2>/dev/null || true
launchctl bootstrap "gui/$(id -u)" "$agent" 2>/dev/null || true

echo "bootstrap: macos steps done."
