#!/usr/bin/env bash
# Linux (Arch devbox) half of the bootstrap task — the `platform` task in
# mise.linux.toml. Only runs on Linux, because mise only loads that config
# there. Idempotent: runs on every `mise bootstrap`.
set -euo pipefail
cd "$(dirname "$0")/.."

# Packages come from [bootstrap.packages]; these are the parts needing root.
# mise's declarative systemd support covers *user* units only.

# Tailscale daemon. `tailscale up --ssh --operator=ani` stays manual — it
# blocks on an auth URL you have to open in a browser, so it can't live in an
# idempotent task.
sudo systemctl enable --now tailscaled

# The user units mise enables need linger to survive logout, and
# taildrop-inbox / reference-repos / simlock-gateway need their target
# directories to exist.
mkdir -p "$HOME/inbox" "$HOME/code/references" "$HOME/.simlock/gateway"
sudo loginctl enable-linger "$USER"

# T3 Code owns its service lifecycle so updates can trial a new runtime and
# roll back a failed handoff. Its systemd drop-in binds it to loopback: the
# T3 Connect tunnel always targets 127.0.0.1, and the tailnet reaches it
# through Tailscale Serve below. `t3 connect` stays manual (browser sign-in).
#
# Server updates from the desktop app move the running server (activeVersion in
# service-state.json) but not a ~/.local/bin/t3 symlink, so a symlink goes stale
# and an older `t3 service install` later refuses to downgrade. Make ~/.local/bin/t3
# a wrapper that execs the active version instead. A real file rather than a
# tracked dotfile: ~/.local/bin is shared with the Mac, and `t3 update` may
# rewrite the path. The unit's ExecStart stays pinned to the version it was
# installed from (a launcher shim), so don't prune that version directory.
# The tracked drop-in alone doesn't count as installed: check for the unit file.
if [[ ! -x "$HOME/.local/bin/t3" ]]; then
  curl -fsSL https://t3.codes/install.sh | T3CODE_CHANNEL=nightly sh
fi
t3_wrapper="$(mktemp "$HOME/.local/bin/.t3.XXXXXX")"
cat >"$t3_wrapper" <<'WRAPPER'
#!/usr/bin/env bash
# Managed by scripts/bootstrap-linux. Runs the T3 version the service is on.
set -euo pipefail
home="${T3CODE_HOME:-$HOME/.t3}"
version="$(sed -n 's/.*"activeVersion": *"\([^"]*\)".*/\1/p' "$home/runtime/service-state.json")"
exec "$home/runtime/versions/${version:?no activeVersion in service-state.json}/t3" "$@"
WRAPPER
chmod 755 "$t3_wrapper"
mv -f "$t3_wrapper" "$HOME/.local/bin/t3"
if [[ -z "$(systemctl --user show -p FragmentPath --value t3code.service)" ]]; then
  "$HOME/.local/bin/t3" service install --base-dir "$HOME/.t3"
fi

# Rex, from Superlogical's pacman repo (preview channel). Not in
# [bootstrap.packages]: packages install before this task adds the repo. Only
# the first install happens here; `update`'s pacman -Syu upgrades it after that.
rex_key=E28636AC71905C6DDE40C1EDFAA6B80F641307A7
if ! sudo pacman-key --list-keys "$rex_key" >/dev/null 2>&1; then
  rex_asc="$(mktemp)"
  curl -fsSL -o "$rex_asc" https://pkgs.superlogical.com/rex/keys/rex.asc
  sudo pacman-key --add "$rex_asc"
  sudo pacman-key --lsign-key "$rex_key"
  rm -f "$rex_asc"
fi
# shellcheck disable=SC2016 # $arch is pacman's, not ours
printf '[rex]\nSigLevel = Required DatabaseRequired\nServer = https://pkgs.superlogical.com/rex/arch/preview/$arch\n' |
  sudo install -m 0644 /dev/stdin /etc/pacman.d/rex.conf
grep -qxF 'Include = /etc/pacman.d/rex.conf' /etc/pacman.conf ||
  echo 'Include = /etc/pacman.d/rex.conf' | sudo tee -a /etc/pacman.conf >/dev/null
# Arch has no partial upgrades, so installing Rex upgrades the system too.
pacman -Q rex >/dev/null 2>&1 || sudo pacman -Syu --needed --noconfirm rex

# The login server runs each caller's sessions as their own account, and only
# it and the shared server (as a `rex` account) can sit behind Tailscale Serve.
# Serve forwards :7297 to this socket below; clients try 443, then 7297, so
# the bare devbox hostname finds it. Restarting the login server keeps sessions.
rex_restart=0
rex_dropin="$(mktemp)"
cat >"$rex_dropin" <<'UNIT'
# Managed by scripts/bootstrap-linux.
[Unit]
After=tailscaled.service
Requires=tailscaled.service

[Service]
ExecStart=
ExecStart=/usr/bin/rex login-server --listen unix:///run/rex/login-server.sock \
  --accounts /etc/rex/accounts.jsonc --runtime-root /run/rex --log-format text \
  --pam-service rex-login-server --extra-listen tailnet-serve:///run/rex/serve.sock
UNIT
rex_dropin_path=/etc/systemd/system/rex-login-server.service.d/tailscale-serve.conf
if ! sudo cmp -s "$rex_dropin" "$rex_dropin_path"; then
  sudo install -D -m 0644 "$rex_dropin" "$rex_dropin_path"
  sudo systemctl daemon-reload
  rex_restart=1
fi
rm -f "$rex_dropin"
# The package ships an accounts file that admits nobody. Fill it once with this
# account's Tailscale login, read at run time to keep it out of this public
# repo; after that, hand edits win.
if grep -qxF '  "accounts": {},' /etc/rex/accounts.jsonc && tailscale status >/dev/null 2>&1; then
  rex_login="$(tailscale status --json | jq -r '.User[(.Self.UserID | tostring)].LoginName')"
  printf '// Written by scripts/bootstrap-linux, which leaves it alone from now on.\n{\n  "version": 1,\n  "accounts": {\n    "%s": { "principals": ["tailscale:%s"] },\n  },\n}\n' \
    "$USER" "$rex_login" | sudo install -m 0644 /dev/stdin /etc/rex/accounts.jsonc
  rex_restart=1
fi
sudo systemctl enable rex-login-server.service
if ((rex_restart)); then
  sudo systemctl restart rex-login-server.service
else
  sudo systemctl start rex-login-server.service
fi
# Tailnet-only HTTPS in front of the loopback server, once `tailscale up` has run.
# `t3 pair --tailscale` reuses this mapping.
# Funnel off first: a leftover Funnel on 443 would make this mapping public.
if tailscale status >/dev/null 2>&1; then
  sudo tailscale funnel --https=443 off >/dev/null 2>&1 || true
  sudo tailscale serve --bg --https=443 http://127.0.0.1:3773
  # Simlock gateway. Workers dial wss://devbox.<tailnet>.ts.net:8443; agents
  # and T3 use https:// there.
  sudo tailscale serve --bg --https=8443 http://127.0.0.1:4700
  # Rex login server (see above). Once the serve config holds a Unix socket,
  # every `tailscale serve` change needs root, hence sudo on all of these.
  sudo tailscale serve --bg --https=7297 unix:/run/rex/serve.sock
fi

# OpenCode 2 always requires a server password and generates a new one on
# every start, which breaks saved client logins. The dev.mise.opencode drop-in
# reads a fixed one from this untracked file. The unit is applied before this
# task runs, so restart it once the file exists.
opencode_env="$HOME/.config/opencode/serve.env"
if [[ ! -f "$opencode_env" ]]; then
  mkdir -p "$(dirname "$opencode_env")"
  (umask 077 && printf 'OPENCODE_SERVER_PASSWORD=%s\n' "$(openssl rand -hex 24)" >"$opencode_env")
  systemctl --user restart dev.mise.opencode.service || true
fi

# 28 days of history: atop for process-level, sysstat/sar for CPU + memory.
sudo sed -i -E 's/^HISTORY=.*/HISTORY=28/' /etc/conf.d/sysstat
sudo systemctl enable --now atop.service sysstat.service

# Keep the QXL display driver out. VMs deployed from a volume (the to-vdo.sh
# cutover) get a QXL adapter instead of virtio-gpu, and QXL's fbdev console
# deadlocks once its 16M VRAM runs dry: "[TTM] Buffer eviction failed" floods
# the log, then PID 1 blocks on a console write and the box needs a hard reset.
if ! grep -q 'modprobe.blacklist=qxl' /etc/default/grub; then
  sudo sed -i -E 's/^(GRUB_CMDLINE_LINUX_DEFAULT=".*)"$/\1 modprobe.blacklist=qxl"/' /etc/default/grub
  sudo grub-mkconfig -o /boot/grub/grub.cfg
fi

# Gradle memory ceilings are a tracked dotfile now — see [dotfiles] in
# mise.linux.toml, which links home/.gradle/gradle.properties.linux.

echo "bootstrap: linux steps done."
