#!/usr/bin/env bash
# Keep Simlock's login services pointing at the current Node and simlock.
#
# `simlock daemon install` writes absolute Node and main.js paths into the unit
# or LaunchAgent, so a mise upgrade of either leaves it `broken`. Re-install
# only then, because a re-install restarts the daemon, which ends agent-device
# leases.
#
# Roles are machine-local and set up by hand (see README):
#   gateway  ~/.simlock/gateway exists (devbox)
#   worker   ~/.simlock/config.json has gateway.url (dev-mbp-14)
# Any other machine gets nothing.
set -euo pipefail

# The service saves PATH, ANDROID_HOME and JAVA_HOME at install time; take
# them from the same place `bash -lc` does.
# shellcheck source=/dev/null
source "$HOME/.bashrc"

command -v simlock >/dev/null 2>&1 || exit 0

ensure() {
  local state
  state="$(simlock "$1" daemon status --json | jq -r '.service.state // "not-installed"')"
  if [[ "$state" != installed ]]; then
    echo "simlock $1: service $state; installing"
    simlock "$1" daemon install
  fi
}

if [[ -d "$HOME/.simlock/gateway" ]]; then
  ensure --gateway
fi
if [[ -f "$HOME/.simlock/config.json" ]] && jq -e '.gateway.url' "$HOME/.simlock/config.json" >/dev/null; then
  ensure --local
fi
