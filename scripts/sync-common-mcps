#!/usr/bin/env bash
set -euo pipefail

command -v bunx >/dev/null 2>&1 || {
  echo "skipping MCP sync: bunx not found"
  exit 0
}

servers=(
  "exa|https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa,web_search_advanced_exa"
  "slack|https://mcp.slack.com/mcp"
)

sync_agent() {
  local agent="$1"
  local cli="$2"

  command -v "$cli" >/dev/null 2>&1 || {
    echo "skipping $agent MCP sync: $cli not found"
    return 0
  }

  local entry name url
  for entry in "${servers[@]}"; do
    name="${entry%%|*}"
    url="${entry#*|}"

    bunx add-mcp "$url" \
      --name "$name" \
      --global \
      --yes \
      --agent "$agent" \
      --transport http
  done

  # browse is Mac-only (see the global mise config). Point at the mise shim:
  # `browse install` would write versioned install paths that break on upgrade.
  local browse="$HOME/.local/share/mise/shims/browse"
  if [[ -x "$browse" ]]; then
    bunx add-mcp "$browse" \
      --args mcp \
      --name browse \
      --global \
      --yes \
      --agent "$agent"
  fi
}

sync_agent claude-code claude
sync_agent codex codex
sync_agent opencode opencode
sync_agent grok-build grok

# Slack's MCP has no dynamic client registration, so OAuth needs a fixed Slack
# app client ID. This one is Slack's own Claude Code plugin app; OpenCode
# borrows it until Slack ships one (slackapi/slack-skills-plugin#15). add-mcp
# can't write it and drops it on every run, so patch it back in afterwards.
slack_client_id="1601185624273.8899143856786"

patch_json() {
  local file="$1" filter="$2" tmp
  [[ -f "$file" ]] || return 0
  tmp="$(mktemp)"
  if jq --arg id "$slack_client_id" "$filter" "$file" >"$tmp"; then
    cat "$tmp" >"$file"
  else
    echo "skipping Slack OAuth patch: couldn't parse $file"
  fi
  rm -f "$tmp"
}

if command -v jq >/dev/null 2>&1; then
  patch_json "$HOME/.claude.json" \
    'if .mcpServers.slack then .mcpServers.slack.oauth = {clientId: $id, callbackPort: 3118} else . end'
  patch_json "${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.jsonc" \
    'if .mcp.slack then .mcp.slack.oauth = {clientId: $id, redirectUri: "http://localhost:3118/callback"} else . end'
else
  echo "skipping Slack OAuth patch: jq not found"
fi
