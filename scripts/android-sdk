#!/usr/bin/env bash
# Restore the Android SDK component set on this machine with Android CLI.
#
#   scripts/android-sdk                 build tooling only (devbox, the M5)
#   scripts/android-sdk --device-host   plus the emulator and a system image
#                                       (dev-mbp-14, the Simlock worker)
#
# Deliberately NOT part of `mise bootstrap`: this fetches several GB from
# Google and accepts licences, which is not something a routine converge
# should do. Run it by hand when rebuilding, or after editing the lists below.
#
# Emulators run only on the device host. Other machines lease them from the
# Simlock gateway, so they get no emulator package and no system images.
#
# The SDK path comes from ~/.androidrc (--sdk), which mise links per platform.
# Idempotent: Android CLI skips anything already installed.
set -euo pipefail

device_host=false
case "${1:-}" in
  "") ;;
  --device-host) device_host=true ;;
  *) echo "usage: $0 [--device-host]" >&2; exit 2 ;;
esac

# Package IDs as `android sdk list --all` prints them (slashes, not semicolons).
BUILD=(
  "cmdline-tools/latest"      # sdkmanager/avdmanager, which Simlock and RN tooling call
  "platform-tools"
  "build-tools/36.0.0"        # one build-tools and one NDK, deliberately —
  "ndk/27.1.12297006"         # the older copies cost ~2 GB and nothing pins them
  "platforms/android-36"
  "platforms/android-35"
  "platforms/android-34"
  "platforms/android-31"
  "cmake/3.30.5"
  "cmake/3.22.1"
)

# Simlock makes its own AVDs from whichever system images are installed.
DEVICE_HOST=(
  "emulator"
  "system-images/android-36/google_apis_playstore/arm64-v8a"
)

packages=("${BUILD[@]}")
if $device_host; then
  packages+=("${DEVICE_HOST[@]}")
fi

echo ">> SDK: $(android info sdk)"
echo ">> installing ${#packages[@]} packages (already-present ones are skipped)"
for package in "${packages[@]}"; do
  android sdk install "$package"
done

echo ">> installed:"
android sdk list
