{
  "gateway": {
    "url": "wss://devbox.emperor-jazz.ts.net:8443",
    "label": "dev-mbp-14"
  },
  "capabilities": {
    "stream": { "enabled": true },
    "input": { "enabled": true },
    "agent-device": {
      "enabled": true,
      "command": "{{ env.HOME }}/.simlock/pinned-agent-device/node_modules/agent-device/bin/agent-device.mjs"
    }
  },
  "capacity": {
    "strategy": "resource",
    "config": {
      "ramBudget": { "iosBytesPerDevice": 7516192768, "iosSlimBytesPerDevice": 3758096384 }
    }
  },
  "warmPool": {
    "maxConcurrentBoots": 1,
    "learn": false,
    "targets": [{ "platform": "ios", "model": "iPhone 17 Pro", "mode": "slim", "count": 1 }]
  },
  "android": { "emulator": { "gpu": "host" } },
  "ios": {
    "defaultMode": "slim",
    "slim": {
      "categories": ["widgets", "siri", "search", "icloud", "family", "health", "apps", "messaging", "connectivity", "telemetry", "other"]
    }
  },
  "update": { "check": false }
}
