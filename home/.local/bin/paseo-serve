#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.local/share/mise/installs/node/22/bin:$HOME/.local/share/mise/installs/bun/1.3/bin:$HOME/.local/bin:$HOME/.bun/bin:/usr/local/bin:/usr/bin:/bin"

TAILSCALE_IP=""
for _ in $(seq 1 30); do
  TAILSCALE_IP="$(tailscale ip -4 2>/dev/null | head -n1 || true)"
  if [ -n "$TAILSCALE_IP" ]; then
    break
  fi
  sleep 2
done

if [ -z "$TAILSCALE_IP" ]; then
  echo "paseo-serve: no Tailscale IPv4 address found" >&2
  exit 1
fi

exec npx --yes @getpaseo/cli daemon start --foreground --listen "$TAILSCALE_IP:6767" --web-ui
