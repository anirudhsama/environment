# theme = Catppuccin Mocha
theme = Catppuccin Macchiato

# font-family = "TX-02"
# font-family = "Maple Mono Normal NF"
font-family = "JetBrains Mono"
font-family = "SF Mono"
font-family = "Kohinoor Devanagari"
font-family = "Kohinoor Bangla"
font-family = "Kohinoor Gujarati"
font-family = "Tamil Sangam MN"
font-family = "Telugu Sangam MN"
font-family = "Kannada Sangam MN"
font-family = "Malayalam Sangam MN"
font-family = "Arial Unicode MS"
font-size = 13

background-opacity = 0.99
background-blur-radius = 20
split-divider-color = #313244 

# macOS specific features
# macos-titlebar-style = transparent
macos-option-as-alt = true 
window-save-state = always
window-vsync = true
window-colorspace = display-p3
quick-terminal-screen = macos-menu-bar
quick-terminal-autohide = false
font-thicken = true
font-thicken-strength = 128

adjust-cursor-thickness = 2
shell-integration = fish
shell-integration-features = no-cursor,sudo,ssh-env,ssh-terminfo
link-url = true
cursor-click-to-move = true
window-padding-x = 8
window-padding-color = extend
window-padding-balance = true
unfocused-split-opacity = 0.90
unfocused-split-fill = black
window-inherit-working-directory = false
working-directory = home
auto-update-channel = stable

keybind = cmd+r=reload_config
keybind = global:cmd+\=toggle_quick_terminal

# Split related shortcuts
keybind = cmd+shift+l=goto_split:right
keybind = cmd+shift+h=goto_split:left
keybind = cmd+shift+j=goto_split:down
keybind = cmd+shift+k=goto_split:up
keybind = cmd+e=equalize_splits
keybind = cmd+k=toggle_command_palette
keybind = cmd+`=goto_window:next
# keybind = cmd+shift+`=goto_window:previous

# Mimic macos keyboard navigation
keybind = cmd+delete=text:\x0b
keybind = cmd+backspace=text:\x15
keybind = opt+delete=esc:d
keybind = shift+enter=text:\n
