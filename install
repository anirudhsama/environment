#!/usr/bin/env bash
# Make this machine match the repo. Idempotent — run after every pull.
#
# --no-folding: link files individually instead of symlinking whole dirs,
# so runtime state (claude sessions, fish_variables, lazy plugins) lands
# NEXT TO tracked configs instead of inside the repo.
set -euo pipefail
cd "$(dirname "$0")"

# This LaunchAgent must be a real file in ~/Library/LaunchAgents, not a Stow
# symlink back into ~/Documents. Remove the managed copy before stowing so
# repeated installs do not conflict, then copy it back in the macOS block below.
if [ "$(uname)" = "Darwin" ]; then
  rm -f "$HOME/Library/LaunchAgents/dev.ani.devbox-drop.plist"
fi

stow --no-folding -R -v -t "$HOME" home

# fish plugins (fisher reads home/.config/fish/fish_plugins)
if command -v fish >/dev/null 2>&1; then
  fish -c 'functions -q fisher; or begin; curl -sL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source; and fisher install jorgebucaran/fisher; end'
  fish -c 'fisher update'
fi

# dev runtimes + fnox, from home/.config/mise/config.toml
if command -v mise >/dev/null 2>&1; then
  mise install
fi

scripts/sync-common-mcps

install_devbox_services() {
  [ "$(uname)" = "Linux" ] || return 0
  command -v opencode >/dev/null 2>&1 || paru -S --noconfirm --needed opencode-bin

  mkdir -p "$HOME/.config/systemd/user"
  install -m 644 systemd/opencode.service "$HOME/.config/systemd/user/opencode.service"

  systemctl --user daemon-reload
  systemctl --user enable --now opencode.service t3-code.service
}

install_devbox_services

# macOS: the DevboxDrop launchd agent and script must be real files outside
# ~/Documents. launchd-spawned processes can be denied TCC access to this repo,
# and login-time agent discovery is fragile when the plist is a Stow symlink
# into Documents. Copy both files into launchd-readable locations and load them.
if [ "$(uname)" = "Darwin" ]; then
  mkdir -p "$HOME/.local/libexec"
  install -m 755 home/.local/bin/devbox-drop-sync.sh "$HOME/.local/libexec/devbox-drop-sync.sh"
  mkdir -p "$HOME/DevboxDrop"
  mkdir -p "$HOME/Library/LaunchAgents"
  agent="$HOME/Library/LaunchAgents/dev.ani.devbox-drop.plist"
  launchctl bootout "gui/$(id -u)/dev.ani.devbox-drop" 2>/dev/null || true
  rm -f "$agent"
  install -m 644 home/Library/LaunchAgents/dev.ani.devbox-drop.plist "$agent"
  launchctl enable "gui/$(id -u)/dev.ani.devbox-drop" 2>/dev/null || true
  launchctl bootstrap "gui/$(id -u)" "$agent" 2>/dev/null || true
fi

echo "done. optional: nvim --headless '+Lazy! restore' +qa   # pre-fetch nvim plugins"
